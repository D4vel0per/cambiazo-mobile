{
  "expo": {
    "name": "Cambiazo!",
    "slug": "cambiazo-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon-exchange.png",
    "scheme": "cambiazomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.d4veloper.cambiazomobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.d4veloper.cambiazomobile"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A6B2D",
          "image": "./assets/images/splash-icon-exchange.png",
          "dark": {
            "image": "./assets/images/splash-icon-exchange.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 512,
          "imageHeight": 512
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5dc5f9f2-8ab1-4530-a37b-189e32763bc7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5dc5f9f2-8ab1-4530-a37b-189e32763bc7"
    }
  }
}
